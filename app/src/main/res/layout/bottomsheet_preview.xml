<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/imgThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"/>

                <ImageView
                    android:id="@+id/imgPlayOverlay"
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:layout_gravity="center"
                    android:alpha="0.90"
                    android:background="@drawable/bg_play_overlay"
                    android:padding="14dp"
                    android:src="@drawable/ic_play"
                    app:tint="@android:color/white"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:text="VIDEO"/>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:maxLines="3"
    android:longClickable="true"
            android:text="Video Title"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtReadMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:focusable="true"
            android:text="Read More"
            android:textStyle="bold"
            android:visibility="gone"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/txtMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@afihacked • 01:25"
            android:clickable="true"
            android:focusable="true"
            app:chipIcon="@drawable/ic_person"
            app:chipIconVisible="true"
            android:textColor="?attr/colorPrimary"
            app:chipBackgroundColor="@android:color/transparent"
            app:chipStrokeColor="?attr/colorPrimary"
            app:chipIconTint="?attr/colorPrimary"
            app:chipStrokeWidth="1dp"/>
        <TextView
            android:id="@+id/txtOpenInTiktok"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Open Video in TikTok"
            android:textColor="?attr/colorPrimary"
            android:drawableEnd="@drawable/ic_open_in_new"

            android:drawablePadding="6dp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Download Options"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideo"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Download HD Video"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMusic"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Download Music"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCover"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Download Cover"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSlides"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Download Slides"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>